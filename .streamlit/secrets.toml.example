# Copy this file to .streamlit/secrets.toml for LOCAL testing only.
# NEVER commit the real secrets.toml to GitHub — add it to .gitignore.
#
# On Streamlit Community Cloud, paste the same keys into:
# App settings -> Secrets

MONGO_URI = "mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
DB_NAME = "dsiar_lms"

# Used only to auto-create the very first admin account on first run.
SEED_ADMIN_EMAIL = "admin@dsiar.com"
SEED_ADMIN_PASSWORD = "ChangeThisImmediately123!"
SEED_ADMIN_NAME = "D'siar Admin"

# Free Daily.co account (no credit card) -> Developers tab -> copy your API key.
# This key is only ever used server-side; it's never sent to students' or
# hosts' browsers, so there's nothing for them to see or leak.
DAILY_API_KEY = "your_daily_api_key_here"
